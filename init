#!/usr/bin/env bash
# Everything the host needs, once: check where we are, check what is missing,
# offer to install it, and build the image.
#
# It exists because a missing `jq` or an unusable `docker` surfaces far from
# the thing that needed it, and because the package names differ per
# distribution.
#
# **It used to check a great deal more.** A display, WSLg on WSL, five Tauri
# libraries through `pkg-config`, a `cc`, and `cargo` — which it refused to
# install, because a packaged Rust is older than the Tauri crates need and says
# so only as a compile error inside a dependency. All of that was the bundled
# launcher's prerequisite list, and the launcher is gone: the editor runs on the
# host and is the reader's own, so whoever can run it has a display by
# definition.
#
# Safe to run again: every step is either a check or `setup`, which rewrites the
# manifest and rebuilds the image.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

say() { printf 'init: %s\n' "$1"; }
die() { printf 'init: %s\n' "$1" >&2; exit 1; }

# --- where we are ------------------------------------------------------------
#
# The launcher opens a native window, so what matters is not the distribution
# but whether anything can draw. WSL is called out separately because it is the
# one environment where every command below succeeds and the window still never
# appears — WSLg is what provides the display, and a WSL 1 or a stripped WSL 2
# has none.

case "$(uname -s)" in
    Linux) ;;
    *) die "this expects Linux, or WSL. Found $(uname -s)." ;;
esac

IS_WSL=no
if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null; then
    IS_WSL=yes
    say "WSL detected."
fi

# --- what is missing ---------------------------------------------------------
#
# Checked by name. The package names differ per distribution and are listed
# rather than guessed from the command name: `docker` comes from `docker.io` on
# Debian, and getting that wrong installs something else entirely.
#
# Two, and it used to be eleven. Eight of the nine that went were Tauri's
# documented prerequisite list, for building the launcher that no longer exists;
# the ninth was `whiptail`, which `setup` stopped needing when it started asking
# with `read`.

MISSING_COMMANDS=()
for command_ in jq docker; do
    command -v "$command_" >/dev/null 2>&1 || MISSING_COMMANDS+=("$command_")
done

# --- offering to install it --------------------------------------------------

# shellcheck source=packages.sh
. "$HERE/packages.sh"


if [ "${#MISSING_COMMANDS[@]}" -gt 0 ]; then
    if command -v apt-get >/dev/null 2>&1; then
        MANAGER=apt
        INSTALL=(sudo apt-get install -y --no-install-recommends)
    elif command -v dnf >/dev/null 2>&1; then
        MANAGER=dnf
        INSTALL=(sudo dnf install -y)
    elif command -v pacman >/dev/null 2>&1; then
        MANAGER=pacman
        INSTALL=(sudo pacman -S --needed --noconfirm)
    else
        die "missing: ${MISSING_COMMANDS[*]}
      No apt, dnf or pacman here, so this cannot name the packages for you.
      Install the equivalents and run this again."
    fi

    PACKAGES=()
    for want in "${MISSING_COMMANDS[@]}"; do
        package="$(packages_for "$MANAGER" "$want")"
        [ -n "$package" ] && PACKAGES+=("$package")
    done

    say "missing on this host: ${MISSING_COMMANDS[*]}"
    printf 'init: would run: %s %s\n' "${INSTALL[*]}" "${PACKAGES[*]}"
    read -r -p "init: install them now? [y/N] " answer
    case "$answer" in
        [yY]*) "${INSTALL[@]}" "${PACKAGES[@]}" ;;
        *) die "nothing installed. Install those packages and run this again." ;;
    esac
fi

if ! docker info >/dev/null 2>&1; then
    die "docker is installed but not usable by this user.
      Either the daemon is not running, or you are not in the 'docker' group:
          sudo systemctl enable --now docker
          sudo usermod -aG docker \"\$USER\"   # then log out and back in"
fi

# --- the image ---------------------------------------------------------------

say "building the image (stack selection follows)."
"$HERE/setup"

say "done. Open this project in your editor on the host, with the"
say "jvsl.env.agents.vscode extension installed; it brings the container up."
