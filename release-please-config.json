{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "extra-files": [
        "start/Cargo.toml",
        {
          "type": "json",
          "path": "start/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "start/Cargo.lock",
          "jsonpath": "$.package[?(@.name=='start')].version"
        }
      ]
    }
  }
}
