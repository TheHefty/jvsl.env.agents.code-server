#!/usr/bin/env bash
# The short way in: build the launcher if it is stale, then run it.
#
# What it replaces is two commands and one long path — `cd .code-server/start &&
# cargo build --release` followed by `.code-server/start/target/release/start` —
# and, more usefully, the mistake in between: editing the launcher, forgetting
# the build, and running yesterday's binary while wondering why the change did
# nothing.
#
# Not generated by `init` and not a symlink. It finds its own directory, so
# there is nothing about a particular checkout to bake in — and a file generated
# inside `.code-server/` would leave the submodule dirty for every consuming
# repo, which is the same reason the stack manifest lives one level up.
#
# It cannot be called `start`: that is the crate's directory, right beside this.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CRATE="$HERE/start"
BINARY="$CRATE/target/release/start"

if ! command -v cargo >/dev/null 2>&1; then
    echo "dev: cargo is not installed. Run $HERE/init, which checks for it and everything else." >&2
    exit 1
fi

# Stale means older than any source of it: the Rust, the injected script, the
# manifests. `find -newer` rather than a timestamp we keep somewhere, because a
# file we keep is a file that goes stale itself.
needs_building() {
    [ ! -x "$BINARY" ] && return 0
    [ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" "$CRATE/tauri.conf.json" \
        "$CRATE/capabilities" -newer "$BINARY" -print -quit 2>/dev/null)" ]
}

if needs_building; then
    echo "dev: the launcher is older than its source; building."
    (cd "$CRATE" && cargo build --release)
fi

# WSLg draws through a compositor WebKit does not get on with: left alone, the
# window opens and stays **blank** — no error, no exit, nothing in a log. The
# variable is WebKit's own switch for that path and costs a desktop nothing,
# which is why it is set here rather than asked about.
if grep -qiE '(microsoft|wsl)' /proc/version 2>/dev/null; then
    export WEBKIT_DISABLE_COMPOSITING_MODE="${WEBKIT_DISABLE_COMPOSITING_MODE:-1}"
fi

exec "$BINARY" "$@"
