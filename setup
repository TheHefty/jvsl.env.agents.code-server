#!/usr/bin/env bash
# Selects the dev environment's stacks, rewrites the manifest, and builds
# the image. Runs on the host (not inside the container) — it's what builds
# the image, so it can't depend on anything from inside it.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# .code-server is always a submodule directly under the consuming repo's
# root (see docs/overview/setup.md) — REPO_ROOT is that root, one level up.
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
STACKS_DIR="$SCRIPT_DIR/stacks"
COMPOSE="$SCRIPT_DIR/core/compose-dockerfile.sh"
# Lives in the consuming repo's own root (tracked by its own history), not
# inside .code-server/: .code-server is a shared submodule pointing at this
# template, and per-project stack selection has to survive `git submodule`
# updates instead of being local, uncommittable state inside vendored code.
MANIFEST="$REPO_ROOT/.code-server.stack.json"
DOCKERFILE_OUT="$SCRIPT_DIR/Dockerfile"
IMAGE_NAME="${IMAGE_NAME:-$(basename "$REPO_ROOT")-dev}"

for bin in jq docker; do
    command -v "$bin" >/dev/null 2>&1 || {
        echo "setup: '$bin' must be installed on the host." >&2
        exit 1
    }
done

if [ ! -d "$STACKS_DIR" ] || [ -z "$(ls -A "$STACKS_DIR" 2>/dev/null)" ]; then
    echo "setup: no stacks found in $STACKS_DIR." >&2
    exit 1
fi

if [ -f "$MANIFEST" ]; then
    CURRENT="$(cat "$MANIFEST")"
    # Refused rather than replaced. This file is the only per-project record of
    # intent, and the next thing this script does is write over it — so a
    # manifest it cannot read is a manifest whose contents would be destroyed by
    # proceeding. A person is sitting in front of this and can fix the JSON.
    if ! jq -e . >/dev/null 2>&1 <<<"$CURRENT"; then
        echo "setup: $MANIFEST is not valid JSON, so it cannot be rewritten without losing" >&2
        echo "setup: whatever it holds. Fix the file and run this again." >&2
        exit 1
    fi
else
    CURRENT='{}'
fi

# **Interactive only when standard input is a terminal**, decided once here so
# there is a single place to look when two callers behave differently. That is
# the cost of an invisible switch, accepted deliberately over a flag: the flag
# is what FR-65 of the extension's SRS exists to avoid.
#
# A caller that has a terminal and is not a person redirects: `setup
# </dev/null`. The editor's build runs in a pty, so without that redirect it
# would stop here asking questions the editor already asked. That failure is at
# least visible — a terminal with a question on it — which is the direction to
# fail in.
INTERACTIVE=no
[ -t 0 ] && INTERACTIVE=yes

# Asks once. The prompt and the default go to stderr, so a caller capturing
# stdout gets the answer and nothing else.
#
# **A failed read is a refusal, not an empty answer.** Input that runs out mid
# question used to be unrepresentable — whiptail owned the terminal — and with a
# re-asking loop it is the difference between stopping and spinning forever.
ask() {
    local prompt="$1" default="$2" answer
    if [ -n "$default" ]; then
        printf 'setup: %s [%s]: ' "$prompt" "$default" >&2
    else
        printf 'setup: %s: ' "$prompt" >&2
    fi
    if ! IFS= read -r answer; then
        echo >&2
        echo "setup: no more input while asking: $prompt" >&2
        exit 1
    fi
    [ -z "$answer" ] && answer="$default"
    printf '%s' "$answer"
}

# Asks until the answer passes. The validator is a function name; it prints what
# was wrong with the answer and returns non-zero.
#
# whiptail's --checklist and --menu could only return something from the list
# they were given, so this did not exist. A `read` returns anything, and an
# answer that reaches the composer produces a Dockerfile that fails minutes
# later inside `docker build`, naming neither the answer nor the question.
ask_until() {
    local prompt="$1" default="$2" validate="$3" answer
    while true; do
        answer="$(ask "$prompt" "$default")"
        if "$validate" "$answer"; then
            printf '%s' "$answer"
            return 0
        fi
    done
}

KNOWN_STACKS=()
for stack_dir in "$STACKS_DIR"/*/; do
    KNOWN_STACKS+=("$(basename "$stack_dir")")
done

CURRENT_STACKS="$(jq -r 'keys[] | select(. != "limits")' <<<"$CURRENT" | paste -sd' ' -)"

valid_stacks() {
    local name
    for name in $1; do
        printf '%s\n' "${KNOWN_STACKS[@]}" | grep -qx "$name" && continue
        echo "setup: there is no stack called '$name'. Available: ${KNOWN_STACKS[*]}" >&2
        return 1
    done
    return 0
}

SELECTED_RAW=""
if [ "$INTERACTIVE" = yes ]; then
    echo "setup: stacks available: ${KNOWN_STACKS[*]}" >&2
    SELECTED_RAW="$(ask_until "which stacks (space-separated, empty for core only)" \
        "$CURRENT_STACKS" valid_stacks)"
else
    SELECTED_RAW="$CURRENT_STACKS"
fi

SELECTED_STACKS=()
if [ -n "$SELECTED_RAW" ]; then
    mapfile -t SELECTED_STACKS < <(xargs -n1 <<<"$SELECTED_RAW")
fi

# Validates inter-stack dependencies: a stack may declare an optional
# requires.json (array of stack names) that must also be selected. Kept
# generic rather than special-cased, since android/java won't stay the only
# pair — fails loudly instead of silently changing the user's selection.
for name in "${SELECTED_STACKS[@]+"${SELECTED_STACKS[@]}"}"; do
    requires_file="$STACKS_DIR/$name/requires.json"
    [ -f "$requires_file" ] || continue
    while IFS= read -r dep; do
        if ! printf '%s\n' "${SELECTED_STACKS[@]}" | grep -qx "$dep"; then
            echo "setup: stack '$name' requires '$dep' — select it too." >&2
            exit 1
        fi
    done < <(jq -r '.[]' "$requires_file")
done

# The new manifest starts as the current one with everything this script owns
# stripped out: every stack name it knows about, and `limits`. What it owns it
# rewrites below; what it does not own it must not touch.
#
# It used to start from '{}', which meant a stack unchecked here disappeared —
# correct, and the reason it was written that way — **and so did anything a
# project had put in this file by hand.** Silently: the write succeeds and the
# key is simply gone on the next read. That stopped a feature from being able to
# keep its own setting here at all — see the Open questions of
# docs/PLANNING/host-editor-replaces-the-launcher/opening-a-configured-project/
# tasks/generating-the-dev-container-configuration.md — and it would have eaten
# any other just as quietly.
#
# Stripping the stack names rather than keeping only the selected ones is what
# preserves the "no uninstall logic" behaviour: a deselected stack is absent
# because its key was removed here and not re-added below.
STRIP="$(printf '%s\n' "${KNOWN_STACKS[@]}" | jq -R . | jq -s '. + ["limits"]')"
NEW_MANIFEST="$(jq --argjson strip "$STRIP" \
    'with_entries(select(.key as $k | $strip | index($k) | not))' <<<"$CURRENT")"

ASK_STACK=""
valid_version() {
    jq -e --arg v "$1" 'index($v) != null' "$STACKS_DIR/$ASK_STACK/versions.json" >/dev/null && return 0
    echo "setup: '$1' is not a version $ASK_STACK offers. Available: $(jq -r 'join(" ")' "$STACKS_DIR/$ASK_STACK/versions.json")" >&2
    return 1
}

for name in "${SELECTED_STACKS[@]+"${SELECTED_STACKS[@]}"}"; do
    versions_file="$STACKS_DIR/$name/versions.json"
    CURRENT_VERSION="$(jq -r --arg s "$name" '.[$s] // empty' <<<"$CURRENT")"
    [ -n "$CURRENT_VERSION" ] || CURRENT_VERSION="$(jq -r '.[0]' "$versions_file")"

    if [ "$INTERACTIVE" = yes ]; then
        ASK_STACK="$name"
        VERSION="$(ask_until "version of $name ($(jq -r 'join(" ")' "$versions_file"))" \
            "$CURRENT_VERSION" valid_version)"
    else
        VERSION="$CURRENT_VERSION"
    fi

    NEW_MANIFEST=$(jq --arg s "$name" --arg v "$VERSION" '. + {($s): $v}' <<<"$NEW_MANIFEST")
done

# The limits the container runs under. Asked after the stacks because they are
# usually left alone: the defaults offered are whatever the manifest already
# says, and whatever the generated configuration would use on its own the first
# time round.
#
# They live in the same manifest for the same reason the stack selection does —
# they are per-project intent, they depend on the machine this is checked out
# on, and anything kept inside `.code-server/` is the submodule's own tree.
#
# the host-side client reads them; nothing in the image does, so changing one needs the
# container recreated, not rebuilt.
CURRENT_MEMORY="$(jq -r '.limits.memory // "6g"' <<<"$CURRENT")"
CURRENT_SWAP="$(jq -r '.limits.memorySwap // empty' <<<"$CURRENT")"
CURRENT_CPUS="$(jq -r '.limits.cpus // empty' <<<"$CURRENT")"

valid_size() {
    [[ "$1" =~ ^[0-9]+[mg]$ ]] && return 0
    echo "setup: '$1' is not a size: a number followed by m or g, e.g. 6g." >&2
    return 1
}
valid_size_or_empty() {
    [ -z "$1" ] && return 0
    valid_size "$1"
}
valid_cpus_or_empty() {
    [ -z "$1" ] && return 0
    [[ "$1" =~ ^[1-9][0-9]*$ ]] && return 0
    echo "setup: '$1' is not a whole number of cores." >&2
    return 1
}

if [ "$INTERACTIVE" = yes ]; then
    echo "setup: a memory limit the host cannot supply does not fail as a refusal — the" >&2
    echo "setup: container never reaches it, the host kills whichever process allocated" >&2
    echo "setup: last, and nothing records why." >&2
    MEMORY="$(ask_until "memory the container may use" "$CURRENT_MEMORY" valid_size)"

    # Total memory *plus* swap, which is why it can never be below memory —
    # Docker refuses the pair and its message names neither value. Left empty,
    # the client derives memory + 2g.
    SWAP="$(ask_until "memory plus swap, empty to derive memory + 2g" "$CURRENT_SWAP" valid_size_or_empty)"

    # How many cores to pin, and pinning is the point: this becomes
    # `--cpuset-cpus`, which `nproc` inside the container reflects, and not
    # `--cpus`, which it does not. Anything that sizes its own parallelism from
    # the CPU count oversubscribes under a quota it cannot see.
    CPUS="$(ask_until "cores to pin, empty for half the host's" "$CURRENT_CPUS" valid_cpus_or_empty)"
else
    MEMORY="$CURRENT_MEMORY"
    SWAP="$CURRENT_SWAP"
    CPUS="$CURRENT_CPUS"
fi

NEW_MANIFEST=$(jq --arg m "$MEMORY" '. + {limits: {memory: $m}}' <<<"$NEW_MANIFEST")
if [ -n "$SWAP" ]; then
    NEW_MANIFEST=$(jq --arg s "$SWAP" '.limits += {memorySwap: $s}' <<<"$NEW_MANIFEST")
fi
if [ -n "$CPUS" ]; then
    NEW_MANIFEST=$(jq --argjson c "$CPUS" '.limits += {cpus: $c}' <<<"$NEW_MANIFEST")
fi

# **Written only when there were answers, or when there was no file.**
#
# The quiet path has nothing to write: it derived everything from the manifest,
# so writing it back can only differ from what is there — and differing means
# inventing. The exception is a project with no manifest at all: `{}` is written
# so the next run reads a recorded default instead of inferring one again, which
# is the whole difference between a default and a guess.
if [ "$INTERACTIVE" = yes ]; then
    echo "$NEW_MANIFEST" | jq '.' > "$MANIFEST"
elif [ ! -f "$MANIFEST" ]; then
    echo '{}' > "$MANIFEST"
fi

# Composes the Dockerfile: core + each selected stack (dependencies first),
# with {{VERSION}} substituted with the chosen version. Always from scratch —
# never hand-edited. The composition itself lives in core/compose-dockerfile.sh
# so CI builds stacks exactly the way this does; STACK_MANIFEST is what makes
# it use the versions just chosen above instead of its lowest-listed default.
STACK_MANIFEST="$MANIFEST" "$COMPOSE" "${SELECTED_STACKS[@]}" > "$DOCKERFILE_OUT"

echo "setup: Dockerfile generated at $DOCKERFILE_OUT"
echo "setup: building image '$IMAGE_NAME'..."
docker build -f "$DOCKERFILE_OUT" -t "$IMAGE_NAME" "$SCRIPT_DIR"
echo "setup: image '$IMAGE_NAME' ready."
