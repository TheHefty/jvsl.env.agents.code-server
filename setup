#!/usr/bin/env bash
# Seleciona as stacks do ambiente de dev, regrava o manifest e builda a
# imagem. Roda no host (não dentro do container) — é o que builda a imagem,
# então não pode depender de nada de dentro dela.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STACKS_DIR="$SCRIPT_DIR/stacks"
CORE_FRAG="$SCRIPT_DIR/core/Dockerfile.frag"
MANIFEST="$SCRIPT_DIR/.stack.json"
DOCKERFILE_OUT="$SCRIPT_DIR/Dockerfile"
IMAGE_NAME="${IMAGE_NAME:-$(basename "$(cd "$SCRIPT_DIR/.." && pwd)")-dev}"

for bin in jq whiptail docker; do
    command -v "$bin" >/dev/null 2>&1 || {
        echo "setup: '$bin' precisa estar instalado no host." >&2
        exit 1
    }
done

if [ ! -d "$STACKS_DIR" ] || [ -z "$(ls -A "$STACKS_DIR" 2>/dev/null)" ]; then
    echo "setup: nenhuma stack encontrada em $STACKS_DIR." >&2
    exit 1
fi

if [ -f "$MANIFEST" ]; then
    CURRENT="$(cat "$MANIFEST")"
else
    CURRENT='{}'
fi

# Monta o checklist a partir das pastas em stacks/, pré-marcando o que já
# está no manifest atual.
CHECKLIST_ARGS=()
for stack_dir in "$STACKS_DIR"/*/; do
    name="$(basename "$stack_dir")"
    if jq -e --arg s "$name" 'has($s)' <<<"$CURRENT" >/dev/null; then
        status=on
    else
        status=off
    fi
    CHECKLIST_ARGS+=("$name" "$name" "$status")
done

if ! SELECTED_RAW=$(whiptail --title "setup" --checklist \
        "Selecione as stacks do monorepo (espaço marca, enter confirma)" \
        20 70 10 "${CHECKLIST_ARGS[@]}" 3>&1 1>&2 2>&3); then
    echo "setup: cancelado." >&2
    exit 1
fi

mapfile -t SELECTED_STACKS < <(xargs -n1 <<<"$SELECTED_RAW")

# Pra cada stack selecionada, pergunta a versão (usando a versão atual do
# manifest, se já houver, como default) e monta o novo manifest do zero —
# stacks desmarcadas simplesmente não entram, sem lógica de desinstalação.
NEW_MANIFEST='{}'
for name in "${SELECTED_STACKS[@]}"; do
    versions_file="$STACKS_DIR/$name/versions.json"
    VERSION_MENU_ARGS=()
    while IFS= read -r v; do
        VERSION_MENU_ARGS+=("$v" "$v")
    done < <(jq -r '.[]' "$versions_file")

    CURRENT_VERSION="$(jq -r --arg s "$name" '.[$s] // empty' <<<"$CURRENT")"
    DEFAULT_ARGS=()
    if [ -n "$CURRENT_VERSION" ]; then
        DEFAULT_ARGS=(--default-item "$CURRENT_VERSION")
    fi

    if ! VERSION=$(whiptail --title "setup" "${DEFAULT_ARGS[@]}" --menu \
            "Versão de $name" 15 50 6 "${VERSION_MENU_ARGS[@]}" 3>&1 1>&2 2>&3); then
        echo "setup: cancelado." >&2
        exit 1
    fi

    NEW_MANIFEST=$(jq --arg s "$name" --arg v "$VERSION" '. + {($s): $v}' <<<"$NEW_MANIFEST")
done

echo "$NEW_MANIFEST" | jq '.' > "$MANIFEST"

# Compõe o Dockerfile: core + cada stack selecionada, com {{VERSION}}
# substituído pela versão escolhida. Sempre do zero — nunca editado à mão.
cat "$CORE_FRAG" > "$DOCKERFILE_OUT"
for name in "${SELECTED_STACKS[@]}"; do
    version="$(jq -r --arg s "$name" '.[$s]' "$MANIFEST")"
    {
        echo
        sed "s/{{VERSION}}/$version/g" "$STACKS_DIR/$name/Dockerfile.frag"
    } >> "$DOCKERFILE_OUT"
done

echo "setup: Dockerfile gerado em $DOCKERFILE_OUT"
echo "setup: buildando imagem '$IMAGE_NAME'..."
docker build -f "$DOCKERFILE_OUT" -t "$IMAGE_NAME" "$SCRIPT_DIR"
echo "setup: imagem '$IMAGE_NAME' pronta."
